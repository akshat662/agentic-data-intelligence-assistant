# Copy to .env.local for local development.
# Base URL of the ADIA FastAPI backend (adia/api) -- no trailing slash. Next.js inlines
# NEXT_PUBLIC_* variables at BUILD time, not at server start -- on Vercel (or any other host),
# set this as a project/build environment variable before the build runs, not after.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
