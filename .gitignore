# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/

# --- uv ---
.uv/

# --- Testing & coverage ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Ruff / mypy ---
.ruff_cache/
.mypy_cache/

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Data (keep folder, ignore contents) ---
# Loose/raw data artifacts are ignored by default; specific registered evaluation datasets
# and their generated catalogs are tracked explicitly below.
data/*
!data/.gitkeep
!data/README.md
!data/registry.json
!data/superstore.csv
!data/catalog/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Evidence / run artifacts (future runtime output) ---
adia/evidence/**/*.json
adia/evidence/**/*.db

# --- Benchmark run output (generated by bench/runner.py and bench/evaluation_report.py) ---
bench/results/*.json
bench/results/*.md
!bench/results/.gitkeep

# --- IDE ---
.vscode/
.idea/
*.swp

# --- OS ---
.DS_Store
