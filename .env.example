# Copy this file to .env and fill in real values. Every variable below is actually read by the
# code cited next to it — nothing here is a placeholder for unbuilt functionality.

# --- LLM provider ---
# Required for the feasibility/planner/argument-generator/synthesizer agents
# (adia/agents/llm_config.py::load_llm_settings) to call OpenAI. Never commit a real key —
# this file is a template, not where secrets live.
OPENAI_API_KEY=
# Optional; defaults to adia.agents.llm_config.DEFAULT_MODEL ("gpt-4o-mini") if unset.
OPENAI_MODEL=

# --- API server (adia/api) ---
# Origins allowed to call the API from a browser, comma-separated. Defaults to just
# http://localhost:3000 (the Next.js dev server) if unset. Set this to your deployed frontend's
# URL in production (adia/api/app.py::_cors_origins) -- never "*".
ADIA_CORS_ORIGINS=http://localhost:3000
# Port `python -m adia.api` binds to (adia/api/__main__.py). Most PaaS platforms (Render,
# Railway, ...) inject PORT themselves; ADIA_API_PORT is a fallback for hosts that don't, and
# both default to 8000 if neither is set.
# PORT=8000
# ADIA_API_PORT=8000
# Host to bind to; 0.0.0.0 (the default) works both locally and in a container/PaaS. Only
# override if you specifically need to bind a single interface.
# ADIA_API_HOST=0.0.0.0
# Set to "true" to run uvicorn with auto-reload for local development. Defaults to off, since
# `python -m adia.api` is also the production start command and reload has no place there.
# ADIA_API_RELOAD=true
