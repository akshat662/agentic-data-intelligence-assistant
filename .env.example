# Copy this file to .env and fill in real values.
# Most of these variables are placeholders for configuration planned in later milestones
# (API, UI) — see each section. OPENAI_API_KEY / OPENAI_MODEL are read now, by
# adia.agents.llm_config.load_llm_settings (used by adia.agents.feasibility).

# --- LLM provider ---
# Required for the feasibility agent (adia/agents/feasibility.py) to call OpenAI. Never
# commit a real key — this file is a template, not where secrets live.
OPENAI_API_KEY=
# Optional; defaults to adia.agents.llm_config.DEFAULT_MODEL if unset.
OPENAI_MODEL=

# --- Application ---
# ENV=development
# LOG_LEVEL=INFO

# --- Data layer ---
# DUCKDB_PATH=./data/adia.duckdb

# --- API (planned) ---
# API_HOST=0.0.0.0
# API_PORT=8000
